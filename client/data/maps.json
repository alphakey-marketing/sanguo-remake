 "landmarks": [
  {
   "id": "xudu_palace",
   "map": "xuchang",
   "x": 35,
   "y": 19,
   "r": 3,
   "name": "許都皇城",
   "text": "建安元年（196），曹操迎漢獻帝，遷都於許，改稱許都。自此「奉天子以令不臣」，天下諸侯側目。"
  },
  {
   "id": "xutian",
   "map": "field_1",
   "x": 32,
   "y": 38,
   "r": 5,
   "name": "許田圍場",
   "text": "演義第二十回：曹操請天子許田射鹿，借天子寶雕弓金鈚箭一發中鹿，群臣望見金箭，以為天子射中，齊呼萬歲。操縱馬直出，遮於天子之前受之。關公大怒，提刀欲斬，玄德急搖手送目止之。"
  },
  {
   "id": "tuntian",
   "map": "field_1",
   "x": 74,
   "y": 12,
   "r": 5,
   "name": "許下屯田",
   "text": "建安元年，曹操用棗祗、韓浩之議，募民屯田許下，一年得穀百萬斛。自此州郡例置田官，征伐四方而無運糧之勞。"
  },
  {
   "id": "yingshui",
   "map": "field_1",
   "x": 40,
   "y": 67,
   "r": 3,
   "name": "潁水渡",
   "text": "潁水出嵩山，東南流經許昌之南，潁川郡因此得名。潁川多名士：荀彧、荀攸、郭嘉、陳群、徐庶，皆出此郡。"
  },
  {
   "id": "yiting",
   "map": "field_1",
   "x": 40,
   "y": 23,
   "r": 2,
   "name": "許昌驛亭",
   "text": "驛路分岔：東行通汝南，南渡潁水往宛城、新野。（東、南兩路尚未開通）"
  },
  {
   "id": "runan_mouth",
   "map": "field_1",
   "x": 101,
   "y": 61,
   "r": 3,
   "name": "汝南山洞",
   "text": "山洞往東南深入汝南郡界。鄉人話洞中聚咗山賊猛獸，最深處更有妖物作祟，唔好一個人去。"
  }
 ],
