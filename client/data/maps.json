 "landmarks": [
  {
   "id": "xudu_palace",
   "map": "xuchang",
   "x": 35,
   "y": 19,
   "r": 3,
   "name": "許都皇城",
   "text": "建安元年（196），曹操迎漢獻帝，遷都於許，改稱許都。自此「奉天子以令不臣」，天下諸侯側目。"
  },
  {
   "id": "xutian",
   "map": "field_1",
   "x": 32,
   "y": 38,
   "r": 5,
   "name": "許田圍場",
   "text": "演義第二十回：曹操請天子許田射鹿，借天子寶雕弓金鈚箭一發中鹿，群臣望見金箭，以為天子射中，齊呼萬歲。操縱馬直出，遮於天子之前受之。關公大怒，提刀欲斬，玄德急搖手送目止之。"
  },
  {
   "id": "tuntian",
   "map": "field_1",
   "x": 74,
   "y": 12,
   "r": 5,
   "name": "許下屯田",
   "text": "建安元年，曹操用棗祗、韓浩之議，募民屯田許下，一年得穀百萬斛。自此州郡例置田官，征伐四方而無運糧之勞。"
  },
  {
   "id": "yingshui",
   "map": "field_1",
   "x": 40,
   "y": 67,
   "r": 3,
   "name": "潁水渡",
   "text": "潁水出嵩山，東南流經許昌之南，潁川郡因此得名。潁川多名士：荀彧、荀攸、郭嘉、陳群、徐庶，皆出此郡。"
  },
  {
   "id": "yiting",
   "map": "field_1",
   "x": 40,
   "y": 23,
   "r": 2,
   "name": "許昌驛亭",
   "text": "驛路分岔：東行通汝南道，南過潁水往昆陽、宛城、新野。"
  },
  {
   "id": "runan_mouth",
   "map": "field_1",
   "x": 101,
   "y": 61,
   "r": 3,
   "name": "汝南山洞",
   "text": "山洞往東南深入汝南郡界。鄉人話洞中聚咗山賊猛獸，最深處更有妖物作祟，唔好一個人去。"
  },
  {
   "id": "runan_bandits",
   "map": "runan_road",
   "x": 80,
   "y": 27,
   "r": 3,
   "name": "汝南賊寨",
   "text": "建安五年（200），汝南黃巾劉辟等叛曹應袁紹，袁紹遣劉備引兵與劉辟會合，攻略許下。寨中至今仍聚住一班亡命之徒。"
  },
  {
   "id": "kunyang_ruins",
   "map": "kunyang",
   "x": 45,
   "y": 46,
   "r": 4,
   "name": "昆陽故城",
   "text": "更始元年（23），劉秀以數千之眾守昆陽，大破王莽號稱百萬之軍。時雷電大風，屋瓦皆飛，莽軍赴滍水死者以萬數，滍水為之不流。"
  },
  {
   "id": "yushui",
   "map": "wancheng_road",
   "x": 31,
   "y": 14,
   "r": 3,
   "name": "淯水",
   "text": "演義第十六回：曹操征張繡，繡降而復叛，夜襲曹營。典韋獨擋寨門，身被數十槍而死；長子曹昂、侄曹安民皆歿。操敗走淯水，後祭典韋而哭。"
  },
  {
   "id": "wancheng_gate",
   "map": "wancheng_road",
   "x": 12,
   "y": 14,
   "r": 2,
   "name": "宛城東門",
   "text": "宛城，南陽郡治，荊北重鎮。城門緊閉，守軍喊話：「城中戒嚴，閒人免進！」（宛城尚未開放）"
  },
  {
   "id": "bowang_po",
   "map": "bowang",
   "x": 45,
   "y": 30,
   "r": 4,
   "name": "博望坡",
   "text": "演義第三十九回：諸葛亮初出茅廬，於博望坡伏兵，「左有山名豫山，右有林名安林」。夏侯惇追入狹谷，蘆葦中火起，曹軍大敗。此乃孔明用兵第一功。"
  },
  {
   "id": "xinye_yamen",
   "map": "xinye",
   "x": 31,
   "y": 16,
   "r": 3,
   "name": "新野縣衙",
   "text": "劉備依劉表，屯兵新野。徐庶化名單福投效，教破曹仁八門金鎖陣；後徐庶走馬薦諸葛，玄德三顧茅廬於隆中。"
  }
 ],
