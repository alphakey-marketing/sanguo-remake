 "landmarks": [
  {
   "id": "xudu_palace",
   "map": "xuchang",
   "x": 35,
   "y": 19,
   "r": 3,
   "name": "許都皇城",
   "text": "建安元年（196），曹操迎漢獻帝，遷都於許，改稱許都。自此「奉天子以令不臣」，天下諸侯側目。"
  },
  {
   "id": "xutian",
   "map": "field_1",
   "x": 32,
   "y": 38,
   "r": 5,
   "name": "許田圍場",
   "text": "演義第二十回：曹操請天子許田射鹿，借天子寶雕弓金鈚箭一發中鹿，群臣望見金箭，以為天子射中，齊呼萬歲。操縱馬直出，遮於天子之前受之。關公大怒，提刀欲斬，玄德急搖手送目止之。"
  },
  {
   "id": "tuntian",
   "map": "field_1",
   "x": 74,
   "y": 12,
   "r": 5,
   "name": "許下屯田",
   "text": "建安元年，曹操用棗祗、韓浩之議，募民屯田許下，一年得穀百萬斛。自此州郡例置田官，征伐四方而無運糧之勞。"
  },
  {
   "id": "yingshui",
   "map": "field_1",
   "x": 40,
   "y": 67,
   "r": 3,
   "name": "潁水渡",
   "text": "潁水出嵩山，東南流經許昌之南，潁川郡因此得名。潁川多名士：荀彧、荀攸、郭嘉、陳群、徐庶，皆出此郡。"
  },
  {
   "id": "yiting",
   "map": "field_1",
   "x": 40,
   "y": 23,
   "r": 2,
   "name": "許昌驛亭",
   "text": "驛路分岔：東行通汝南道，南過潁水往昆陽、宛城、新野。"
  },
  {
   "id": "runan_mouth",
   "map": "field_1",
   "x": 101,
   "y": 61,
   "r": 3,
   "name": "汝南山洞",
   "text": "山洞往東南深入汝南郡界。鄉人話洞中聚咗山賊猛獸，最深處更有妖物作祟，唔好一個人去。"
  },
  {
   "id": "runan_bandits",
   "map": "runan_road",
   "x": 80,
   "y": 27,
   "r": 3,
   "name": "汝南賊寨",
   "text": "建安五年（200），汝南黃巾劉辟等叛曹應袁紹，袁紹遣劉備引兵與劉辟會合，攻略許下。寨中至今仍聚住一班亡命之徒。"
  },
  {
   "id": "kunyang_ruins",
   "map": "kunyang",
   "x": 45,
   "y": 46,
   "r": 4,
   "name": "昆陽故城",
   "text": "更始元年（23），劉秀以數千之眾守昆陽，大破王莽號稱百萬之軍。時雷電大風，屋瓦皆飛，莽軍赴滍水死者以萬數，滍水為之不流。"
  },
  {
   "id": "yushui",
   "map": "wancheng_road",
   "x": 31,
   "y": 14,
   "r": 3,
   "name": "淯水",
   "text": "演義第十六回：曹操征張繡，繡降而復叛，夜襲曹營。典韋獨擋寨門，身被數十槍而死；長子曹昂、侄曹安民皆歿。操敗走淯水，後祭典韋而哭。"
  },
  {
   "id": "wancheng_gate",
   "map": "wancheng_road",
   "x": 12,
   "y": 14,
   "r": 2,
   "name": "宛城東門",
   "text": "宛城，南陽郡治，荊北重鎮。城門緊閉，守軍喊話：「城中戒嚴，閒人免進！」（宛城尚未開放）"
  },
  {
   "id": "bowang_po",
   "map": "bowang",
   "x": 45,
   "y": 30,
   "r": 4,
   "name": "博望坡",
   "text": "演義第三十九回：諸葛亮初出茅廬，於博望坡伏兵，「左有山名豫山，右有林名安林」。夏侯惇追入狹谷，蘆葦中火起，曹軍大敗。此乃孔明用兵第一功。"
  },
  {
   "id": "xinye_yamen",
   "map": "xinye",
   "x": 31,
   "y": 16,
   "r": 3,
   "name": "新野縣衙",
   "text": "劉備依劉表，屯兵新野。徐庶化名單福投效，教破曹仁八門金鎖陣；後徐庶走馬薦諸葛，玄德三顧茅廬於隆中。"
  },
  {
   "id": "chenliu_gate",
   "map": "chenliu",
   "x": 47,
   "y": 12,
   "r": 4,
   "name": "陳留城",
   "text": "中平六年，曹操逃出洛陽，至陳留散家財、合義兵，衛茲資助，「首倡義兵」討董卓。"
  },
  {
   "id": "yudu_camp",
   "map": "yudu",
   "x": 20,
   "y": 25,
   "r": 4,
   "name": "于毒山寨",
   "text": "初平二年，黑山賊于毒、白繞、眭固等十餘萬眾寇東郡，曹操引兵入東郡，破白繞於濮陽，後攻于毒本屯。"
  },
  {
   "id": "xiaopei_yuanmen",
   "map": "xiaopei",
   "x": 37,
   "y": 16,
   "r": 3,
   "name": "轅門",
   "text": "建安元年，袁術遣紀靈攻劉備於小沛，呂布於轅門植戟，一箭正中小支，兩家罷兵 —— 轅門射戟。"
  },
  {
   "id": "runan_ding",
   "map": "runan_city",
   "x": 48,
   "y": 17,
   "r": 3,
   "name": "丁刺史府",
   "text": "丁原，字建陽，任并州刺史，以呂布為主簿，甚見親待。董卓遣李肅以赤兔馬、金珠說布，布遂殺原投卓。"
  },
  {
   "id": "wancheng_pailou",
   "map": "wancheng",
   "x": 35,
   "y": 26,
   "r": 3,
   "name": "宛城牌樓",
   "text": "建安二年，曹操征張繡於宛，繡降而復叛，典韋死戰門中，長子曹昂、侄曹安民皆歿。"
  },
  {
   "id": "gangkou_pier",
   "map": "gangkou",
   "x": 45,
   "y": 42,
   "r": 3,
   "name": "渡船處",
   "text": "孫堅年十七，與父乘船至錢唐，遇海賊胡玉等於匏里上岸劫掠。堅獨提刀上岸，揮手東西若分部人兵，賊以為官兵至，棄財散走。"
  },
  {
   "id": "fancheng_wall",
   "map": "fancheng",
   "x": 64,
   "y": 28,
   "r": 3,
   "name": "樊城",
   "text": "建安二十四年，關羽圍曹仁於樊城，秋雨漢水暴溢，于禁七軍皆沒 —— 水淹七軍，威震華夏。"
  },
  {
   "id": "hanshui_ferry",
   "map": "hanshui",
   "x": 40,
   "y": 13,
   "r": 3,
   "name": "漢水渡口",
   "text": "建安十三年，劉表卒，曹操南下。劉備自樊城南渡漢水，荊州士民十餘萬相隨，日行十餘里。"
  },
  {
   "id": "xiangyang_palace",
   "map": "xiangyang",
   "x": 37,
   "y": 20,
   "r": 3,
   "name": "襄陽宮宅",
   "text": "初平元年，劉表單騎入宜城，用蒯良、蒯越之謀平定荊州，徙治襄陽，開立學官，荊州一時安定。"
  },
  {
   "id": "changsha_town",
   "map": "changsha",
   "x": 23,
   "y": 6,
   "r": 3,
   "name": "長沙",
   "text": "中平四年，區星作亂，孫堅為長沙太守，旬月破之，封烏程侯。後關羽戰黃忠於長沙，黃忠、魏延歸劉備。"
  }
 ],
